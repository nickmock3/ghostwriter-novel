# .env.local にコピーし、使うproviderだけ値を入れてください。
# 実APIキーや非公開base URLはコミットしないでください。

# Provider APIキー。環境変数はOSシークレットストアより優先されます。
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
GHOSTWRITER_OPENAI_COMPATIBLE_API_KEY=

# 任意のprovider base URL上書き。空のままならアプリ側の既定値を使います。
GHOSTWRITER_DEEPSEEK_BASE_URL=
GHOSTWRITER_OPENAI_BASE_URL=
GHOSTWRITER_GEMINI_BASE_URL=
GHOSTWRITER_ANTHROPIC_BASE_URL=
GHOSTWRITER_OPENAI_COMPATIBLE_BASE_URL=
GHOSTWRITER_OPENAI_COMPATIBLE_MODELS=
GHOSTWRITER_OPENAI_COMPATIBLE_TOOL_MODELS=

# 任意の既定チャットモデル。未設定の場合は deepseek / deepseek-v4-pro を使います。
GHOSTWRITER_DEFAULT_PROVIDER=deepseek
GHOSTWRITER_DEFAULT_MODEL=deepseek-v4-pro

# 任意のAGENTS.md読み込み上限バイト数。
GHOSTWRITER_MAX_AGENTS_MD_BYTES=65536

# 任意のアプリデータ保存root。相対値はサーバー起動cwd基準。未設定時は .data
GHOSTWRITER_DATA_DIR=.data

# 旧 SIMPLE_AI_AGENT_* は互換のため読み取りだけ継続します。
# 新旧の両方が設定されている場合は GHOSTWRITER_* が優先されます。

# Cloudflare R2 への未署名デスクトップ preview アップロード用（任意）。
# 値は .env.local または GitHub Actions secrets にだけ設定してください。
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
